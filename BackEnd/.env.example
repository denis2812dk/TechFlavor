PORT=3000
APP_ALLOWED_ORIGINS=http://localhost:5173

# Base plataforma: usuarios, sesiones, restaurantes y asignaciones.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=techflavor_platform
DB_PORT=3306

# Bases tenant: una base por restaurante. Si se omiten, usa los valores DB_*.
TENANT_DB_HOST=localhost
TENANT_DB_USER=root
TENANT_DB_PASSWORD=
TENANT_DB_PORT=3306
TENANT_DB_CONNECTION_LIMIT=5

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=
RESEND_EMAIL_FROM=no-reply@example.com
